.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Local configuration, SDK paths & environment
local.properties
.env
.env.*
!.env.example

# Private developer suite (unreleased/internal only)
app/src/internal/

# Signing keys, certificates & credentials
*.jks
*.keystore
*.p12
*.pem
*.key
keystore.properties
google-services.json

# IDE and workspace files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db

# Logs, trace dumps, and scratch files
*.log
*.tmp
*.bak
*.swp
*~
research/
tools/
scratch/

